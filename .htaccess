# sandrapudja.com — Hostinger
DirectoryIndex index.php index.html
RewriteEngine On
# force https + non-www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://sandrapudja.com%{REQUEST_URI} [L,R=301]
# old .html links -> .php
RewriteRule ^index\.html$ / [R=301,L]
RewriteRule ^de/index\.html$ /de/ [R=301,L]
RewriteRule ^(.+)\.html$ /$1.php [R=301,L]
# consulting page was replaced by the right-hand page
RewriteRule ^production-consulting(\.php)?$ /right-hand.php [R=301,L]
RewriteRule ^de/production-consulting(\.php)?$ /de/right-hand.php [R=301,L]
# Nov 2026: service pages renamed to match the new four services
RewriteRule ^(de/)?tv-production(\.php)?$ /$1media-creator-projects.php [R=301,L]
RewriteRule ^(de/)?shoot-organisation(\.php)?$ /$1operations-project-support.php [R=301,L]
RewriteRule ^(de/)?tv-producer-berlin(\.php)?$ /$1producer-berlin.php [R=301,L]
# clean URLs: /tv-production -> tv-production.php
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([^\.]+)$ $1.php [NC,L]
# caching
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/jpeg "access plus 1 month"
ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
<FilesMatch "\.(html|php)$">
Header set Cache-Control "private, no-store, max-age=0"
Header merge Vary "Cookie"
</FilesMatch>
</IfModule>
AddDefaultCharset UTF-8
